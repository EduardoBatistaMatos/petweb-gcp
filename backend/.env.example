# Copie este arquivo para .env e preencha as configurações locais.
# PostgreSQL
DB_HOST=localhost
DB_PORT=5432
DB_NAME=petshop
DB_USER=postgres
DB_PASSWORD=sua_senha_aqui

# Servidor HTTP
SERVER_HOST=localhost
SERVER_PORT=8080

# Google Cloud Storage
GCP_PROJECT_ID=seu-projeto-gcp
GCS_BUCKET_NAME=fatec-2026-grupo-d
# Caminho para a chave JSON da conta de serviço (não versionar)
GOOGLE_APPLICATION_CREDENTIALS=C:/caminho/para/sua-chave.json
